{
  "_schema_version": "2.0",

  "colors": {
    "background":      "#000000",
    "surface":         "#080808",
    "surface_pressed": "#171717",
    "border":          "#1A1A1A",
    "border_active":   "#333333",
    "text_primary":    "#F4F4F5",
    "text_secondary":  "#A1A1AA",
    "text_muted":      "#52525B",
    "accent":          "#E11D48",
    "accent_surface":  "#4C0519",
    "secondary":       "#06B6D4",
    "secondary_surface": "#083344",
    "safe":            "#10B981",
    "warning":         "#F59E0B",
    "critical":        "#E11D48"
  },

  "font_family": "monospace",
  "hud_font_size_sp": 11.0,
  "dock_font_size_sp": 12.5,
  "omni_font_size_sp": 12.5,

  "dock_slots": [
    { "index": 1, "label": "TERMINAL", "subtitle": "VoidTerm",           "package_name": "",            "action": "open_voidterm" },
    { "index": 2, "label": "FILES",    "subtitle": "Browse Projects",    "package_name": "",            "action": "open_files" },
    { "index": 3, "label": "DRAWER",   "subtitle": "All Applications",  "package_name": "",            "action": "open_drawer" },
    { "index": 4, "label": "BROWSER",  "subtitle": "WebAuth & Links",    "package_name": "",            "action": "open_browser" },
    { "index": 5, "label": "SETTINGS", "subtitle": "Void Customizer",   "package_name": "",            "action": "open_settings" }
  ],

  "default_home_mode": "COCKPIT",
  "show_telemetry_bar": true,
  "show_nodeos_card": true,
  "show_intent_card": true,
  "show_notifications_card": true,
  "notifications_max_count": 5,
  "filter_ongoing_notifications": true,
  "show_dock": true,
  "show_digit_keypad": true,
  "use_system_wallpaper": false,
  "cockpit_card_radius_dp": 14.0,
  "show_status_bar_time": true,
  "show_status_bar_battery": true,
  "show_status_bar_ram": true,

  "gesture_swipe_up": "OPEN_DRAWER",
  "gesture_swipe_down": "NOTIFICATIONS",
  "gesture_swipe_left": "OPEN_DRAWER",
  "gesture_swipe_right": "OPEN_FILES",
  "gesture_double_tap": "TOGGLE_MINIMAL",
  "gesture_long_press": "OPEN_SETTINGS",

  "compound_gestures_enabled": true,
  "gesture_two_finger_up": "OPEN_HUD",
  "gesture_pinch_in": "TOGGLE_MINIMAL",
  "gesture_pinch_out": "COCKPIT_MODE",
  "gesture_left_edge_swipe": "OPEN_FILES",
  "gesture_right_edge_swipe": "OPEN_DRAWER",
  "gesture_bottom_edge_swipe": "FOCUS_OMNI",

  "show_app_icons": true,
  "app_icon_style": "original",
  "drawer_alpha": 0.90,
  "drawer_edge_transparent": true,
  "drawer_width_percent": 85,
  "enable_atoz_scrubber": true,

  "files_default_path": "/storage/emulated/0",
  "files_show_hidden": true,

  "thermal_limit_celsius": 39.0,
  "thermal_guardian_enabled": true,
  "thermal_kill_commands": [
    "pkill -f 'nodeos.*daemon'",
    "pkill -f 'python.*agent'"
  ],
  "thermal_hysteresis_celsius": 2.0,

  "default_identity": "VOID",
  "identity_void_label": "[VOID]",
  "identity_main_label": "[MAIN]",
  "active_persona": "void",
  "personas": [
    { "id": "void",   "label": "[VOID]",   "subtitle": "Runtimes & Compilers",       "accent": "#E11D48", "secondary": "#06B6D4", "workspace": "/data/data/com.termux/files/home/Projects" },
    { "id": "still",  "label": "[STILL]",  "subtitle": "Obsidian OLED Minimalist",   "accent": "#007AFF", "secondary": "#8E8E93", "workspace": "/data/data/com.termux/files/home/Projects" },
    { "id": "main",   "label": "[MAIN]",   "subtitle": "SaaS & Production",          "accent": "#06B6D4", "secondary": "#10B981", "workspace": "/data/data/com.termux/files/home/Projects" },
    { "id": "agent",  "label": "[AGENT]",  "subtitle": "Autonomous Loops",           "accent": "#8B5CF6", "secondary": "#06B6D4", "workspace": "/data/data/com.termux/files/home/Projects" },
    { "id": "client", "label": "[CLIENT]", "subtitle": "PodPitch Workspace",         "accent": "#F59E0B", "secondary": "#10B981", "workspace": "/data/data/com.termux/files/home/Projects/PodPitch" }
  ],

  "omni_bar_hint": ">_ search apps or enter :cmd",
  "omni_prompt_symbol": ">_ ",
  "omni_fuzzy_max_results": 5,
  "command_history_enabled": true,
  "command_history_limit": 500,

  "default_workspace_path": "/data/data/com.termux/files/home/Projects",
  "workflow_json_path":     "/data/data/com.termux/files/home/Projects/workflow.json",
  "nodeos_db_path":         "/data/data/com.termux/files/home/Projects/agy_nodeos.db",

  "enable_glyph_pulse": true,
  "glyph_patterns_path": "/storage/emulated/0/.voidlauncher/glyph_patterns.json",
  "enable_haptics": true,

  "clock_format": "HH:mm:ss",
  "clock_suffix": " UTC+6",

  "telemetry_poll_ms": 1500,
  "power_profile_adaptive": true,

  "ast_graph_enabled": false,
  "ast_graph_node_cap": 80,

  "agent_orchestrator_enabled": true,

  "widgets_enabled": false,
  "widgets_directory": "/storage/emulated/0/.voidlauncher/widgets",

  "focus_scheduler_enabled": true,
  "focus_schedule_path": "/storage/emulated/0/.voidlauncher/focus_schedule.json",

  "notif_whitelist_packages": ["com.termux", "com.google.android.dialer"],
  "notif_blacklist_packages": [],
  "notif_priority_keywords": ["error", "failed", "agent", "completed", "critical", "warning"],

  "voidterm_enabled": false,
  "voidterm_rows": 8,
  "voidterm_cols": 48,

  "macros_enabled": true,
  "macros_directory": "/storage/emulated/0/.voidlauncher/macros"
}
