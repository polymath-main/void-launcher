<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pitch_black"
    android:clipToPadding="false">

    <!-- Top Cockpit Container -->
    <LinearLayout
        android:id="@+id/topCockpitLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Line 0: Real-time Host Telemetry Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="18:07:32 UTC+6" />

            <TextView
                android:id="@+id/tvBatteryTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/emerald_safe"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="▲ 42% [34.2°C]" />

            <TextView
                android:id="@+id/tvMemory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="RAM: 4.8G" />

            <TextView
                android:id="@+id/btnQuickSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:padding="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="⚙" />
        </LinearLayout>

        <!-- Zone 1: NodeOS & Telemetry HUD Card -->
        <LinearLayout
            android:id="@+id/telemetryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cockpit_card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDaemonStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/cyan_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:text="● NODEOS: ALIVE" />

                <TextView
                    android:id="@+id/tvAstCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:text="AST: 1,428" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/cockpit_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvWorkspace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:text="CWD: ~/Projects" />

                <TextView
                    android:id="@+id/tvGitBranch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:text="git: main" />
            </LinearLayout>
        </LinearLayout>

        <!-- Zone 2: Intent & Identity Stream Card -->
        <LinearLayout
            android:id="@+id/intentCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_cockpit_card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvIdentityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_identity_badge"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/void_crimson"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:text="[VOID]" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:text="ACTIVE WORKFLOW INTENT" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActiveIntent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:text="Ready for execution." />
        </LinearLayout>
    </LinearLayout>

    <!-- Zone: Built-in Files Browser Container -->
    <LinearLayout
        android:id="@+id/filesBrowserLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_cockpit_card"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topCockpitLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomAnchorLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Files Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/btnFilesUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/cyan_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="↑ UP" />

            <TextView
                android:id="@+id/tvFilesCurrentPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="start"
                android:text="~/Projects" />

            <TextView
                android:id="@+id/btnFilesNewFolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="+DIR" />

            <TextView
                android:id="@+id/btnFilesClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:padding="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/void_crimson"
                android:textSize="13sp"
                android:text="✕" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cockpit_border" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Zone 3: Dynamic Fuzzy Search App List Overlay -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAppFilter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_cockpit_card"
        android:padding="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topCockpitLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomAnchorLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Terminal Output Panel -->
    <TextView
        android:id="@+id/tvTerminalOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_cockpit_card"
        android:padding="10dp"
        android:fontFamily="monospace"
        android:textColor="@color/cyan_accent"
        android:textSize="11sp"
        android:visibility="gone"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/topCockpitLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomAnchorLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Anchored Zone (Sits directly on top of keyboard space) -->
    <LinearLayout
        android:id="@+id/bottomAnchorLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Zone 4: Bare-Integer Fast Dock -->
        <LinearLayout
            android:id="@+id/bareIntegerDock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/btnSlot1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bare_slot"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:text="[1] TERMINAL" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:text="Termux · VoidTerm" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSlot2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bare_slot"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:text="[2] FILES" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:text="Browse Projects" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSlot3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bare_slot"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:text="[3] DRAWER" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:text="All Applications" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSlot4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bare_slot"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:text="[4] BROWSER" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:text="WebAuth &amp; Links" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSlot5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bare_slot"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:text="[5] SETTINGS" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:text="Void Customizer" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fast Numerical Jump Row (Keypad) -->
        <LinearLayout
            android:id="@+id/digitKeypadRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/keyDigit1"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_digit_btn"
                android:gravity="center"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="1" />

            <TextView
                android:id="@+id/keyDigit2"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_digit_btn"
                android:gravity="center"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="2" />

            <TextView
                android:id="@+id/keyDigit3"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_digit_btn"
                android:gravity="center"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="3" />

            <TextView
                android:id="@+id/keyDigit4"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_digit_btn"
                android:gravity="center"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="4" />

            <TextView
                android:id="@+id/keyDigit5"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_digit_btn"
                android:gravity="center"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="5" />

            <TextView
                android:id="@+id/keyColon"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_digit_btn"
                android:gravity="center"
                android:fontFamily="monospace"
                android:textColor="@color/void_crimson"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text=":" />

            <TextView
                android:id="@+id/keyBackspace"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_digit_btn"
                android:gravity="center"
                android:fontFamily="monospace"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:text="⌫" />
        </LinearLayout>

        <!-- Zone 5: Omni-Command Bar (Directly Above Keyboard) -->
        <LinearLayout
            android:id="@+id/omniBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_omni_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/void_crimson"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text=">_ " />

            <EditText
                android:id="@+id/etOmniInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="12.5sp"
                android:hint="@string/omni_hint"
                android:imeOptions="actionGo"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btnExecute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="[GO]" />
        </LinearLayout>

    </LinearLayout>

    <!-- Right-Edge Vertical App Drawer (Collapsible Sliding Overlay) -->
    <LinearLayout
        android:id="@+id/rightDrawerLayout"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/cockpit_surface"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Drawer Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="ALL APPLICATIONS" />

            <TextView
                android:id="@+id/tvDrawerAppCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:text="0 APPS" />

            <TextView
                android:id="@+id/btnDrawerClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/void_crimson"
                android:textSize="14sp"
                android:text="✕" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cockpit_border" />

        <!-- Drawer Content: Apps Recycler + A-Z Alphabet Scrubber on far right edge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDrawerApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/alphabetScrubber"
                android:paddingBottom="24dp"
                android:clipToPadding="false" />

            <com.polymath.voidlauncher.ui.AlphabetScrubberView
                android:id="@+id/alphabetScrubber"
                android:layout_width="22dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Right Screen Edge Tab Handle (Quick Drawer Opener) -->
    <TextView
        android:id="@+id/btnDrawerTabHandle"
        android:layout_width="16dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_digit_btn"
        android:gravity="center"
        android:fontFamily="monospace"
        android:textColor="@color/void_crimson"
        android:textSize="10sp"
        android:text="‹"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
