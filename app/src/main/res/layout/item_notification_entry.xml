<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_cockpit_card"
    android:padding="8dp">

    <!-- Top meta row: Icon + App Name + Time + Dismiss -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivNotifIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="fitCenter"
            tools:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/tvNotifAppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/cyan_accent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="DISCORD" />

        <TextView
            android:id="@+id/tvNotifTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            tools:text="2m ago" />

        <TextView
            android:id="@+id/btnNotifDismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="3dp"
            android:fontFamily="monospace"
            android:textColor="@color/void_crimson"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="✕" />
    </LinearLayout>

    <!-- Notification Title -->
    <TextView
        android:id="@+id/tvNotifTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="monospace"
        android:textColor="@color/text_primary"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Polymath Bot: Build Succeeded" />

    <!-- Notification Content Body -->
    <TextView
        android:id="@+id/tvNotifText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="CI run #41227203692 passed for polymath-main/void-launcher with zero errors." />

</LinearLayout>
